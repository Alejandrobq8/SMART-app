# Copia este archivo a .env antes de correr el proyecto (cp .env.example .env)

# Requerida por Prisma. Ruta relativa a prisma/, deja este valor tal cual
# para desarrollo local con SQLite.
DATABASE_URL="file:./dev.db"

# Secreto para firmar la sesión JWT (cookie httpOnly). Si no se define,
# el código cae a un valor inseguro hardcodeado — no lo dejes vacío ni
# siquiera en local. Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-este-valor-por-un-secreto-aleatorio"

# Opcional. Protege el endpoint /api/cron/reminders si se engancha a un
# scheduler real en producción. No es necesaria para uso normal en local.
CRON_SECRET=""
